 logger = logging.getLogger(__name__)
 
@@ -130,9 +131,63 @@ def build_model_and_tokenizer(
     if config.use_lora:
         model = _apply_lora(model, config)
 
+    # 6. Optional: use system RAM as VRAM for the frozen base weights.
+    # Windows PyTorch has no NCCL, so FSDP is unavailable; this single-process
+    # per-layer offload achieves the same effect: frozen fp32 base weights stay
+    # in RAM, each decoder layer is streamed to GPU just before use and moved
+    # back once its gradients are computed. Trainable params (LoRA adapters +
+    # modules_to_save) always stay on GPU.
+    if str2bool(os.environ.get("OMNIVOICE_CPU_OFFLOAD", "false")):
+        _install_cpu_offload(model)
+
     return model, tokenizer
 
 
+def _offload_frozen(module, device):
+    """Move only frozen (requires_grad=False) params of a module to device."""
+    for p in module.parameters():
+        if not p.requires_grad:
+            p.data = p.data.to(device)
+
+
+def _install_cpu_offload(model, device="cuda"):
+    """Stream frozen base weights between RAM and GPU per decoder layer.
+
+    Forward: layer i (and prefetch i+1) are moved to GPU before use.
+    Backward: after a layer's parameter gradients are computed
+    (full backward hook), its frozen weights return to RAM.
+    Eval/no_grad forwards return weights to RAM immediately.
+    """
+    layers = list(model.llm.layers)
+    n = len(layers)
+    print(f"[cpu-offload] installed on {n} decoder layers (frozen base in RAM)")
+
+    def make_pre(i):
+        def pre(module, args):
+            _offload_frozen(module, device)
+            if i + 1 < n:
+                _offload_frozen(layers[i + 1], device)  # prefetch next layer
+        return pre
+
+    def make_post(i):
+        def post(module, args, output):
+            # eval / no_grad path: nothing will need these weights again
+            if not module.training:
+                _offload_frozen(module, "cpu")
+        return post
+
+    def make_bwd(i):
+        def bwd(module, grad_input, grad_output):
+            # param grads of this layer are computed at this point
+            _offload_frozen(module, "cpu")
+        return bwd
+
+    for i, layer in enumerate(layers):
+        layer.register_forward_pre_hook(make_pre(i))
+        layer.register_forward_hook(make_post(i))
+        layer.register_full_backward_hook(make_bwd(i))
+
+
 def _apply_lora(model: OmniVoice, config: TrainingConfig) -> OmniVoice:
     """Wrap the model with PEFT LoRA adapters.
 
